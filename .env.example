# Set these as environment variables (setx on Windows). Never commit a real key.
LTG_PROVIDER=opencode          # opencode (default, CLI) | gemini (free tier) | ollama (local, offline) | groq (free plan)
LTG_MODEL=opencode/<free-model-id-from-opencode-models>   # leave empty to use OpenCode's default model
# LTG_OPENCODE_BIN=C:\path\to\opencode.cmd   # only if `opencode` is not found automatically
# LTG_OPENCODE_AGENT=plan      # read-only agent (recommended)
# LTG_OPENCODE_TIMEOUT=180     # seconds per call
# GEMINI_API_KEY=your-free-key-from-google-ai-studio   # only for LTG_PROVIDER=gemini
# LTG_MIN_INTERVAL=4           # seconds between calls (free-tier per-minute limits)
