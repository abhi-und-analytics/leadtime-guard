{
  "name": "LeadTime Guard - daily risk check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "name": "Every morning 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "command": "cd C:\\projects\\leadtime-guard && set PYTHONPATH=src && .venv\\Scripts\\python -m leadtime_guard.run --provider opencode"
      },
      "name": "Run LeadTime Guard",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "0 red, 0 amber",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Any amber or red?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "content": "Connect a notification here (e.g. Microsoft Teams, Slack or Email node) that sends the summary line and a link to the dashboard to the procurement lead. The draft emails are NOT sent: a person approves them in the dashboard.",
        "height": 200,
        "width": 320
      },
      "name": "Note: notify the team",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [760, -60]
    }
  ],
  "connections": {
    "Every morning 07:00": {
      "main": [[{"node": "Run LeadTime Guard", "type": "main", "index": 0}]]
    },
    "Run LeadTime Guard": {
      "main": [[{"node": "Any amber or red?", "type": "main", "index": 0}]]
    }
  },
  "settings": {}
}
